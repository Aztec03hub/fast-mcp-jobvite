# fast-mcp-jobvite configuration template.  Discharges B53 and B91.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every SECRET-CLASS value here is EMPTY on purpose: a placeholder that looks like
# a credential is the thing a reader copies by accident and a scanner mistakes for
# a finding. The six are JOBVITE_API_KEY, JOBVITE_API_SECRET, JOBVITE_FEED_KEY,
# JOBVITE_FEED_SECRET, JOBVITE_COMPANY_ID and JOBVITE_HTTP_TOKENS.
#
# THE OTHER VALUES ARE DELIBERATELY NOT EMPTY, and emptying them is a defect.
# JOBVITE_MAX_RESULTS=50 and JOBVITE_OUTBOUND_RATE_LIMIT=6 answer the design's
# Q1; the transport and bind defaults are what make a copied template start.
# `test_the_deliberate_non_secret_defaults_are_intact` exists to turn that red,
# because "every value is empty" is the cheapest way to make a stricter-sounding
# assertion pass while un-answering a design question.
#
# This header used to say "every value here is EMPTY", which was false of seven
# values and contradicted the test protecting them. ADR-0014 corrected the same
# sentence in DESIGN.md's C8-I1 row; this is its sibling, and the ADR said
# explicitly that this file was out of its scope.
#
# Only the variables the tools you actually enable are required. See JOBVITE_TOOLS
# below; the server fails at startup naming any required variable that is missing,
# rather than starting and surfacing it later as a confusing Jobvite 401.

# ---------------------------------------------------------------------------
# Jobvite v2 credentials. Required by every tool except get_job_feed.
# Issued by a human at Jobvite Customer Success; there is no self-service.
# Sent as x-jvi-api / x-jvi-sc headers, never in a URL.
# ---------------------------------------------------------------------------
JOBVITE_API_KEY=
JOBVITE_API_SECRET=

# ---------------------------------------------------------------------------
# Jobvite v1 job-feed credentials. Required ONLY by get_job_feed.
# This endpoint structurally requires its secret in the query string, so its URL
# is treated as sensitive and redacted before any log line is emitted.
# The company id is the value after c= in your career-site URL.
# ---------------------------------------------------------------------------
JOBVITE_FEED_KEY=
JOBVITE_FEED_SECRET=
JOBVITE_COMPANY_ID=

# ---------------------------------------------------------------------------
# Tool surface
# ---------------------------------------------------------------------------
# Comma-separated allow-list of tool names. Unset means all READ tools and never
# the write. An unrecognised name is a startup failure, not a silent skip.
#   search_candidates, get_candidate, search_jobs, get_job_feed, create_candidate
JOBVITE_TOOLS=

# create_candidate is registered ONLY when this is true AND the tool is named in
# JOBVITE_TOOLS. Enabling writes is deliberately two steps, and the obvious single
# step does nothing. The write creates a real record in a real ATS and can email a
# live candidate; there is no sandbox to rehearse in.
JOBVITE_ENABLE_WRITES=false

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# stdio (default) or http. stdio is unauthenticated by design: the operating
# system process boundary is the control.
JOBVITE_MCP_TRANSPORT=stdio

# HTTP bind address and port. Only read when the transport is http.
# Binding a non-loopback address requires TLS or the proxy assertion below, and
# the server refuses to start otherwise rather than warning and continuing.
JOBVITE_MCP_HOST=127.0.0.1
JOBVITE_MCP_PORT=8000

# SECRET. Bearer tokens for the HTTP transport, as a JSON object mapping each
# token to the scopes it holds, over the three data classes:
#   {"<token>": ["candidates:read", "jobs:read", "feed:read"]}
# Empty here like every other credential. Unset while the transport is http is a
# startup failure, not an open server.
JOBVITE_HTTP_TOKENS=

# Set true ONLY when TLS is terminated by a proxy in front of this server. It is
# an assertion the server cannot verify, and it is deliberately not a check of
# X-Forwarded-Proto, which is spoofable by anyone who can reach the port. Binding
# a non-loopback address without TLS or this assertion is a startup failure.
JOBVITE_TLS_TERMINATED_BY_PROXY=false

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# In-tool result cap. A search returning more than this reports the total rather
# than truncating silently: "showing 50 of 1,240". The default matches the figure
# the design uses in that caller-facing string, so the two cannot disagree.
JOBVITE_MAX_RESULTS=50

# Outbound self-throttle, requests per minute, against Jobvite.
# THIS IS A CONSERVATIVE GUESS, NOT A VENDOR FIGURE. Jobvite documents no numeric
# rate limit; its only stated envelope is prose - call it as needed, and anything
# more frequent than once a day must be filtered. Credential checklist row 9 is
# what replaces this with an observation.
JOBVITE_OUTBOUND_RATE_LIMIT=6

# The total wall-clock budget for ALL outbound attempts in one tool
# invocation, in seconds (DESIGN.md:1663-1669, ADR-0027). Not a per-request
# timeout: one scan making twenty-five requests shares one budget. 60 is a
# choice made with nothing observed about Jobvite's latency, not a measurement.
JOBVITE_OUTBOUND_BUDGET_SECONDS=60

# ---------------------------------------------------------------------------
# Jobvite quirks
# ---------------------------------------------------------------------------
# Pagination base. Ships 1-based on Jobvite's own v1 documentation, and scans
# start at 0 regardless so a 0-based server cannot lose record zero.
# Override only if you have established the truth against a live tenant.
#
# ONE VALUE, applied to every route the calling tool asks the client for. The
# client's own contract is per-resource (DESIGN.md:517-519) and this variable is
# a single integer; whether it should become a per-resource pair list is U6-F2,
# which is open. Until it is settled, a tenant whose resources DISAGREE about
# the base cannot be expressed here, and this line says so rather than reading
# as though it could. It said "per resource" while offering one value, and for
# one release it reached no code at all (R5-M1).
JOBVITE_PAGINATION_START_BASE=
